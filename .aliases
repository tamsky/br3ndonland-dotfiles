# Detect which `ls` flavor is in use
if ls --color > /dev/null 2>&1; then # GNU `ls` (or macos 26+ CLI-tools)
	colorflag="--color"
else # (pre macos 26+ CLI-tools or /bin/ls)
	colorflag="-G"
fi

# List all files colorized in long format
alias ll="ls -lF ${colorflag}"

# List all files colorized in long format, including dot files
alias la="ls -laF ${colorflag}"

# List only directories
alias lsd="ls -lF ${colorflag} | grep --color=never '^d'"

# Always use color output for `ls`
alias ls="command ls ${colorflag}"
export LS_COLORS='no=00:fi=00:di=01;34:ln=01;36:pi=40;33:so=01;35:do=01;35:bd=40;33;01:cd=40;33;01:or=40;31;01:ex=01;32:*.tar=01;31:*.tgz=01;31:*.arj=01;31:*.taz=01;31:*.lzh=01;31:*.zip=01;31:*.z=01;31:*.Z=01;31:*.gz=01;31:*.bz2=01;31:*.deb=01;31:*.rpm=01;31:*.jar=01;31:*.jpg=01;35:*.jpeg=01;35:*.gif=01;35:*.bmp=01;35:*.pbm=01;35:*.pgm=01;35:*.ppm=01;35:*.tga=01;35:*.xbm=01;35:*.xpm=01;35:*.tif=01;35:*.tiff=01;35:*.png=01;35:*.mov=01;35:*.mpg=01;35:*.mpeg=01;35:*.avi=01;35:*.fli=01;35:*.gl=01;35:*.dl=01;35:*.xcf=01;35:*.xwd=01;35:*.ogg=01;35:*.mp3=01;35:*.wav=01;35:'

# Enable aliases to be sudo’ed
alias sudo='sudo '

# Get week number
alias week='date +%V'

# IP addresses
alias myip="dig +short myip.opendns.com @resolver1.opendns.com"
# http://serverfault.com/questions/89114/finding-the-public-ip-address-in-a-shell-script
alias gmyip="dig @ns1.google.com -t txt o-o.myaddr.l.google.com +short | tr -d\""
alias localip="ipconfig getifaddr en0"
alias ips="ifconfig -a | grep -o 'inet6\? \(addr:\)\?\s\?\(\(\([0-9]\+\.\)\{3\}[0-9]\+\)\|[a-fA-F0-9:]\+\)' | awk '{ sub(/inet6? (addr:)? ?/, \"\"); print }'"

# Flush Directory Service cache
alias flush="dscacheutil -flushcache && killall -HUP mDNSResponder"


# Re-copy styled-HTML clipboard content (Claude Code PR descriptions, etc.) as
# real HTML, not plain text -- useful when a paste accidentally
# selected/overwrote the system clipboard with something else.
#   clipreload              # only auto-picks if exactly one session has a
#                            # cached clip; otherwise lists candidates and
#                            # asks for an id instead of guessing
#   clipreload <session-id> # a specific session's clip (Claude will give you
#                            # the exact id to paste if more than one is live)
alias clipreload="$HOME/.claude/bin/clip-html.sh"
